You are given two strings s and t.
 Return true if t is an anagram of s,
otherwise return fals.

 Formula:
// frequency(s) == frequency(t)

// Rules:
//  Both strings must have same length
//  Characters and their counts must match exactly
//  Case-sensitive (if specified)


// Frequency Count (Single Array Cancelation)

// When to Use (Trigger)
//  Compare two strings
//  Order does not matter
//  Exact frequency matching required



// If two strings are anagrams:
// After incrementing for s and decrementing for t,
// all frequencies will be zero.




// - If lengths differ → return false
// - Traverse both strings simultaneously
// - Increment count for s[i]
// - Decrement count for t[i]
// - Check if all values are zero



// Time: O(n)
// Space: O(1) → fixed 26 lowercase letters



class Solution {
public boolean isAnagram(String s, String t) {
if (s.length() != t.length()) return false;

    int[] freq = new int[26];

    for (int i = 0; i < s.length(); i++) {
        freq[s.charAt(i) - 'a']++;
        freq[t.charAt(i) - 'a']--;
    }

    for (int count : freq) {
        if (count != 0) return false;
    }

    return true;
}

}
