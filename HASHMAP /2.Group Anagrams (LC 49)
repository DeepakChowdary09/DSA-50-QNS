// You are given an array of strings strs.
// Group the anagrams together and return the groups.
// Order of output does not matter.

// Formula:
// Anagrams → same sorted string
// key = sorted(word)



// When to Use (Trigger)
// - Need to group similar strings
// - Equality based on character frequency
// - Order inside word does not matter


// All anagrams share identical sorted representation
// Use sorted string as key in hashmap
// Measurement Logic


// - For each word:
// convert to char array
// sort it
// build string key
// insert into hashmap
// - Return all map values


// Time: O(n * k log k)
// n = number of strings
// k = max string length
// Space: O(n * k)


class Solution {
public List<List<String>> groupAnagrams(String[] strs) {
Map<String, List<String>> map = new HashMap<>();

    for (String str : strs) {
        char[] arr = str.toCharArray();
        Arrays.sort(arr);
        String key = new String(arr);

        map.computeIfAbsent(key, k -> new ArrayList<>()).add(str);
    }

    return new ArrayList<>(map.values());
}


}
