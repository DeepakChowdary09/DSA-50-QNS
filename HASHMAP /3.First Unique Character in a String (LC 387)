// You are given a string s.
// Return the index of the first non-repeating character.
// If it does not exist, return -1.



// Rules:
// - String contains lowercase English letters
// - Return first index with frequency 1

// Pattern
// Frequency Count (Two Pass)

// When to Use (Trigger)
// - Need first element satisfying condition
// - Frequency-based uniqueness
// - Order matters
// Core Invariant
// ─────────────────────────────────────────
// First pass → count frequency of each character
// Second pass → find first index with count == 1

// ─────────────────────────────────────────
// Measurement Logic
// ─────────────────────────────────────────
// - Create frequency array of size 26
// - Count each character
// - Iterate string again
// - Return first index where freq == 1
// Time & Space
// ─────────────────────────────────────────
// Time: O(n)
// Space: O(1)



class Solution {
public int firstUniqChar(String s) {
int[] freq = new int[26];

    for (int i = 0; i < s.length(); i++) {
        freq[s.charAt(i) - 'a']++;
    }

    for (int i = 0; i < s.length(); i++) {
        if (freq[s.charAt(i) - 'a'] == 1) {
            return i;
        }
    }

    return -1;
}


}
