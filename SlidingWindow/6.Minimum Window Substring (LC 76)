// You are given two strings s and t.
// Return the minimum window substring of s
// such that every character in t (including frequency)
// is included in the window.
// If no such substring exists, return "".

// Formula:
// Valid window when all required characters are satisfied
// window length = right − left + 1

// Rules:
// - Characters are case-sensitive
// - Must include exact frequency of each character in t
// - Return smallest valid substring

// Pattern
// Sliding Window + Frequency Map

// When to Use (Trigger)
// - Need smallest valid substring
// - Frequency-based condition
// - Expand + shrink window dynamically


// Maintain:
// - need[] → frequency of characters in t
// - window[] → frequency inside current window
// - formed → number of satisfied unique characters
//
// Window is valid when formed == required


// Pointer Rules 
// - Expand right pointer and update window frequency
// - If character satisfies required count, increment formed
// - When window valid:
// update minimum length
// shrink from left
// update formed if requirement breaks
// Time & Space
// ─────────────────────────────────────────
// Time: O(n)
// Space: O(1) → fixed character set (ASCII)

// ─────────────────────────────────────────
// Code (Clean — No Comments Inside)
// ─────────────────────────────────────────

class Solution {
public String minWindow(String s, String t) {
if (s.length() == 0 || t.length() == 0) return "";

    int[] need = new int[128];
    int[] window = new int[128];

    for (char c : t.toCharArray()) {
        need[c]++;
    }

    int left = 0;
    int right = 0;
    int formed = 0;
    int required = 0;

    for (int i = 0; i < 128; i++) {
        if (need[i] > 0) required++;
    }

    int minLen = Integer.MAX_VALUE;
    int start = 0;

    while (right < s.length()) {
        char c = s.charAt(right);
        window[c]++;

        if (need[c] > 0 && window[c] == need[c]) {
            formed++;
        }

        while (left <= right && formed == required) {
            if (right - left + 1 < minLen) {
                minLen = right - left + 1;
                start = left;
            }

            char ch = s.charAt(left);
            window[ch]--;

            if (need[ch] > 0 && window[ch] < need[ch]) {
                formed--;
            }

            left++;
        }

        right++;
    }

    return minLen == Integer.MAX_VALUE ? "" : s.substring(start, start + minLen);
}


}
