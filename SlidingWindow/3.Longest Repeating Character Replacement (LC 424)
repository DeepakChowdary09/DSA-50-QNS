// You are given a string s and an integer k.
// You can replace at most k characters in the substring
// so that all characters in the substring are the same.
// Return the length of the longest such substring.

// Formula:
// replacements = window length − maxFrequencyInWindow

// Rules:
// - Only uppercase English letters
// - You may replace at most k characters

// Pattern
// Sliding Window + Frequency Count

// When to Use (Trigger)
// - Longest valid substring
// - Limited replacements / modifications
// - Frequency-based window validation

// ─────────────────────────────────────────
// Core Invariant
// ─────────────────────────────────────────
// Window is valid if:
// (right − left + 1) − maxFrequency <= k
// maxFrequency tracks the most frequent character in window

// ─────────────────────────────────────────
// Pointer Rules (Measurement Logic)
// ─────────────────────────────────────────
// - Expand right pointer and update frequency
// - Track maxFrequency in current window
// - If window becomes invalid, move left pointer
// - Update maximum window length

// ─────────────────────────────────────────
// Time & Space
// ─────────────────────────────────────────
// Time: O(n)
// Space: O(1) → fixed 26-length array
class Solution {
public int characterReplacement(String s, int k) {
int[] freq = new int[26];
int left = 0;
int maxFreq = 0;
int maxLen = 0;

    for (int right = 0; right < s.length(); right++) {
        int idx = s.charAt(right) - 'A';
        freq[idx]++;
        maxFreq = Math.max(maxFreq, freq[idx]);

        while (right - left + 1 - maxFreq > k) {
            freq[s.charAt(left) - 'A']--;
            left++;
        }

        maxLen = Math.max(maxLen, right - left + 1);
    }

    return maxLen;
}


}
